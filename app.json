{
  "expo": {
    "name": "ShowroomApp",
    "slug": "ShowroomApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon-v2.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon-v2.png",
      "resizeMode": "cover",
      "backgroundColor": "#06D6A0"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.autoshowroom.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-v2.png",
        "backgroundColor": "#06D6A0"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon-v2.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "eas": {
        "projectId": "b8a368c8-8c5d-450e-a90a-11dcab25cb67"
      }
    }
  }
}